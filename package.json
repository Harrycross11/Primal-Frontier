{
  "name": "primal-frontier",
  "version": "0.1.0",
  "private": true,
  "description": "Survival sandbox prototype: scavenge a barren post-apocalyptic world, gather and build with friends.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "0.186.1",
    "tsx": "4.23.15",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.5.0",
    "concurrently": "^9.0.0",
    "playwright": "1.56.1",
    "typescript": "^5.6.0",
    "vite": "8.3.2"
  }
}
